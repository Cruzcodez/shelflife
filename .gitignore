# ---- Secrets: broad by design ----
# Matches .env, .env.dev, .env.prod, .env.staging, .env.local, .env.anything.
# The narrow Next.js default (.env.local, .env.*.local) is how three prod env
# files end up committed. Don't narrow this.
.env
.env.*
!.env.example
!.env.*.example

*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa*
credentials
.aws/
*.tfstate
*.tfstate.*
.terraform/

# ---- Dependencies ----
node_modules/
.pnp
.pnp.js
__pycache__/
*.py[cod]
.venv/
venv/
.tox/

# ---- Build output ----
dist/
build/
out/
.next/
target/
*.egg-info/
cdk.out/
.cdk.staging/

# ---- Test + coverage ----
coverage/
.coverage
*.lcov
htmlcov/
.pytest_cache/
test-results/
playwright-report/

# ---- Logs ----
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# ---- Editors + OS ----
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~

# ---- Misc ----
*.tsbuildinfo
.cache/
.turbo/
tmp/
